{
    "name": "keil-assistant-clangd",
    "displayName": "Keil Assistant clangd (Personal)",
    "description": "Unofficial personal-use modifications of Keil Assistant with an optional clangd backend",
    "version": "0.1.5",
    "publisher": "AKCX2002",
    "author": {
        "name": "AKCX2002"
    },
    "keywords": [
        "keil",
        "mdk",
        "c51",
        "8051",
        "stm32",
        "arm"
    ],
    "homepage": "https://github.com/AKCX2002/keil-assistant-clangd",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Other"
    ],
    "activationEvents": [
        "onView:project",
        "onCommand:explorer.open",
        "workspaceContains:**/*.uvproj",
        "workspaceContains:**/*.uvprojx",
        "onLanguageModelTool:build_keil_project",
        "onLanguageModelTool:get_keil_project_info"
    ],
    "main": "./dist/extension.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/AKCX2002/keil-assistant-clangd"
    },
    "bugs": {
        "url": "https://github.com/AKCX2002/keil-assistant-clangd/issues"
    },
    "contributes": {
        "configuration": [
            {
                "title": "Keil Assistant clangd (Personal)",
                "properties": {
                    "KeilAssistant.C51.Uv4Path": {
                        "type": "string",
                        "scope": "machine-overridable",
                        "markdownDescription": "C51 UV4.exe 的绝对路径。例如：`C:\\Keil_v5\\UV4\\UV4.exe`\n\n请确保设置正确的路径，否则插件将无法正常工作。",
                        "default": ""
                    },
                    "KeilAssistant.MDK.Uv4Path": {
                        "type": "string",
                        "scope": "machine-overridable",
                        "markdownDescription": "MDK UV4.exe 的绝对路径。例如：`C:\\Keil_v5\\UV4\\UV4.exe`\n\n请确保设置正确的路径，否则插件将无法正常工作。",
                        "default": ""
                    },
                    "KeilAssistant.Project.ExcludeList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "uVision project file name exclude list",
                        "default": [
                            "template.uvproj",
                            "template.uvprojx"
                        ]
                    },
                    "KeilAssistant.Project.FileLocationList": {
                        "type": "array",
                        "scope": "resource",
                        "markdownDescription": "uVision project file locations",
                        "default": []
                    },
                    "KeilAssistant.ProjectExplorer.RememberExpandedState": {
                        "type": "boolean",
                        "scope": "window",
                        "markdownDescription": "Remember expanded Keil project tree nodes between refreshes and reloads.",
                        "default": false
                    },
                    "KeilAssistant.ProjectExplorer.SortOrder": {
                        "type": "string",
                        "scope": "window",
                        "markdownDescription": "Sort order for root Keil projects in the explorer.",
                        "enum": [
                            "legacy",
                            "name",
                            "path"
                        ],
                        "default": "legacy"
                    },
                    "KeilAssistant.ProjectExplorer.AutoRevealCurrentFile": {
                        "type": "boolean",
                        "scope": "window",
                        "markdownDescription": "Automatically reveal the current file in the Keil project tree when possible.",
                        "default": false
                    },
                    "KeilAssistant.LanguageService": {
                        "type": "string",
                        "scope": "window",
                        "enum": [
                            "cpptools",
                            "clangd",
                            "none"
                        ],
                        "default": "cpptools",
                        "markdownDescription": "Language service for this workspace. clangd manages a compilation database and workspace clangd arguments, and disables Microsoft C/C++ IntelliSense. Switching away restores settings it still owns."
                    },
                    "KeilAssistant.Clangd.CompilerPath": {
                        "type": "string",
                        "scope": "resource",
                        "default": "",
                        "markdownDescription": "Optional compiler driver path for clangd. AC6 auto-detects ARMCLANG/bin/armclang.exe from MDK.Uv4Path. AC5 uses a Clang virtual driver."
                    },
                    "KeilAssistant.Clangd.PackRoot": {
                        "type": "string",
                        "scope": "resource",
                        "default": "",
                        "description": "Optional CMSIS Pack root. Otherwise searches CMSIS_PACK_ROOT, LocalAppData/Arm/Packs and Keil ARM/PACK for the exact PackID."
                    },
                    "KeilAssistant.Clangd.SystemIncludes": {
                        "type": "array",
                        "scope": "resource",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Additional toolchain, CMSIS, Pack and RTE include directories, relative to the .uvprojx directory or absolute."
                    },
                    "KeilAssistant.Clangd.ExtraArgs": {
                        "type": "array",
                        "scope": "resource",
                        "items": {
                            "type": "string"
                        },
                        "default": [],
                        "markdownDescription": "Verified Clang arguments appended after generated options, e.g. -mfpu=fpv4-sp-d16 and -mfloat-abi=hard. One argument per array item; do not include shell quoting."
                    },
                    "KeilAssistant.Clangd.CStandard": {
                        "type": "string",
                        "scope": "resource",
                        "enum": [
                            "auto",
                            "c90",
                            "gnu90",
                            "c99",
                            "gnu99",
                            "c11",
                            "gnu11",
                            "c17",
                            "gnu17",
                            "c23",
                            "gnu23"
                        ],
                        "default": "auto",
                        "description": "C language standard override."
                    },
                    "KeilAssistant.Clangd.CppStandard": {
                        "type": "string",
                        "scope": "resource",
                        "enum": [
                            "auto",
                            "c++03",
                            "gnu++03",
                            "c++11",
                            "gnu++11",
                            "c++14",
                            "gnu++14",
                            "c++17",
                            "gnu++17",
                            "c++20",
                            "gnu++20",
                            "c++23",
                            "gnu++23"
                        ],
                        "default": "auto",
                        "description": "C++ language standard override."
                    },
                    "KeilAssistant.Workspace.AutoConfigure": {
                        "type": "boolean",
                        "scope": "window",
                        "default": true,
                        "markdownDescription": "加载或刷新 Keil 工程时，在每个 `.uvproj/.uvprojx` 同目录下安全合并 `.vscode/settings.json`，并按下列开关维护任务。"
                    },
                    "KeilAssistant.Workspace.ExcludeDirectories": {
                        "type": "array",
                        "scope": "resource",
                        "items": {
                            "type": "string"
                        },
                        "default": [
                            ".keil-assistant-clangd",
                            "Objects",
                            "Listings"
                        ],
                        "markdownDescription": "相对 Keil 工程目录的生成目录。插件把缺少的规则加入 `files.exclude`、`search.exclude` 和 `files.watcherExclude`；工程 XML 中实际的输出和列表目录也会加入。"
                    },
                    "KeilAssistant.Workspace.GenerateTasks": {
                        "type": "boolean",
                        "scope": "resource",
                        "default": true,
                        "markdownDescription": "为每个 Keil 工程生成 `.vscode/tasks.json`，并向 VS Code 原生任务列表提供相同任务。关闭后只移除插件标记的任务，保留用户任务。"
                    },
                    "KeilAssistant.Workspace.TaskActions": {
                        "type": "array",
                        "scope": "resource",
                        "items": {
                            "type": "string",
                            "enum": [
                                "build",
                                "rebuild",
                                "download"
                            ]
                        },
                        "uniqueItems": true,
                        "default": [
                            "build",
                            "rebuild"
                        ],
                        "markdownDescription": "生成的 Keil 任务。`download` 会操作真实设备，默认不启用。"
                    }
                }
            }
        ],
        "commands": [
            {
                "command": "keil.build",
                "title": "Keil: Build Active Target",
                "icon": "$(play)"
            },
            {
                "command": "keil.configureWorkspace",
                "title": "Keil: Configure Project Workspace Files",
                "icon": "$(settings-gear)"
            },
            {
                "command": "explorer.open",
                "title": "Open keil uVision project",
                "icon": {
                    "light": "./res/icons/ClassAdded_16x.svg",
                    "dark": "./res/icons/ClassAdded_16x.svg"
                }
            },
            {
                "command": "project.switch",
                "title": "Switch Target",
                "icon": {
                    "light": "./res/icons/SwitchSourceOrTarget_16x.svg",
                    "dark": "./res/icons/SwitchSourceOrTarget_16x.svg"
                }
            },
            {
                "command": "project.active",
                "title": "Active Project"
            },
            {
                "command": "project.close",
                "title": "Close Project",
                "icon": {
                    "light": "./res/icons/StatusOffline_16x.svg",
                    "dark": "./res/icons/StatusOffline_16x.svg"
                }
            },
            {
                "command": "project.build",
                "title": "Build",
                "icon": {
                    "light": "./res/icons/BuildSelection_16x.svg",
                    "dark": "./res/icons/BuildSelection_16x.svg"
                }
            },
            {
                "command": "project.rebuild",
                "title": "Rebuild",
                "icon": {
                    "light": "./res/icons/BuildSolution_16x.svg",
                    "dark": "./res/icons/BuildSolution_16x.svg"
                }
            },
            {
                "command": "project.download",
                "title": "Download To Device",
                "icon": {
                    "light": "./res/icons/TransferDownload_16x.svg",
                    "dark": "./res/icons/TransferDownload_16x.svg"
                }
            },
            {
                "command": "item.copyValue",
                "title": "Copy Item Value",
                "icon": {
                    "light": "./res/icons/CopyToClipboard_16x.svg",
                    "dark": "./res/icons/CopyToClipboard_16x.svg"
                }
            },
            {
                "command": "project.refresh",
                "title": "Refresh Keil Project",
                "icon": {
                    "light": "./res/icons/refresh-light.svg",
                    "dark": "./res/icons/refresh-dark.svg"
                }
            },
            {
                "command": "project.clearCacheAndRefresh",
                "title": "Clear Project Cache And Refresh"
            },
            {
                "command": "project.revealCurrentFile",
                "title": "Reveal Current File In Keil Project",
                "icon": {
                    "light": "./res/icons/ActiveApplication_16x.svg",
                    "dark": "./res/icons/ActiveApplication_16x.svg"
                }
            },
            {
                "command": "keilClangd.selectBackend",
                "title": "Keil clangd: Select Language Service"
            },
            {
                "command": "keilClangd.showStatus",
                "title": "Keil clangd: Show Configuration Status"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "explorer.open",
                    "group": "navigation",
                    "when": "view == project"
                },
                {
                    "command": "project.refresh",
                    "group": "navigation@1",
                    "when": "view == project"
                },
                {
                    "command": "project.revealCurrentFile",
                    "group": "navigation@2",
                    "when": "view == project"
                },
                {
                    "command": "keil.build",
                    "group": "navigation@3",
                    "when": "view == project"
                },
                {
                    "command": "keil.configureWorkspace",
                    "group": "navigation@4",
                    "when": "view == project"
                }
            ],
            "view/item/context": [
                {
                    "command": "project.close",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.active",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.refresh",
                    "group": "navigation",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.clearCacheAndRefresh",
                    "group": "navigation",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.revealCurrentFile",
                    "group": "navigation",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.switch",
                    "group": "inline",
                    "when": "viewItem == Project"
                },
                {
                    "command": "project.build",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.rebuild",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "project.download",
                    "group": "inline",
                    "when": "viewItem == Target"
                },
                {
                    "command": "item.copyValue",
                    "group": "inline",
                    "when": "viewItem == Source"
                }
            ]
        },
        "keybindings": [
            {
                "command": "project.build",
                "key": "f7"
            },
            {
                "command": "project.rebuild",
                "key": "ctrl+alt+f7"
            },
            {
                "command": "project.download",
                "key": "ctrl+alt+d"
            }
        ],
        "languageModelTools": [
            {
                "name": "build_keil_project",
                "displayName": "Build Keil Project",
                "modelDescription": "Build or rebuild a Keil project target. Returns compilation results including errors and warnings with file paths, line numbers, and error codes. Use this tool when: 1) User asks to compile/build/rebuild a Keil project or embedded firmware, 2) User mentions 'build the project' or 'compile the code', 3) User wants to check for compilation errors, 4) User asks to verify if the code compiles successfully.",
                "userDescription": "Build or rebuild a Keil uVision project target",
                "icon": "$(tools)",
                "tags": [
                    "build",
                    "compile",
                    "keil",
                    "embedded",
                    "firmware"
                ],
                "toolReferenceName": "buildKeilProject",
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "target": {
                            "type": "string",
                            "description": "The name of the specific target configuration to build (e.g., 'Debug', 'Release'). If omitted, the currently active target will be built."
                        },
                        "rebuild": {
                            "type": "boolean",
                            "description": "Set to true to perform a clean rebuild (recompile all files), or false for incremental build (compile only changed files). Default: false.",
                            "default": false
                        }
                    }
                }
            },
            {
                "name": "get_keil_project_info",
                "displayName": "Get Keil Project Info",
                "modelDescription": "Get detailed information about the current Keil project including project name, type (C51/C251/ARM), active target, all available targets, and source file list. Use this tool when: 1) User asks 'what is the current project', 'show project info', or 'list project files', 2) User wants to know available build targets, 3) User asks about project configuration or structure, 4) You need to understand the project context before building or making changes, 5) User asks about the project type (C51/ARM/C251).",
                "userDescription": "Get information about the current Keil uVision project",
                "icon": "$(info)",
                "tags": [
                    "info",
                    "project",
                    "keil",
                    "structure",
                    "configuration"
                ],
                "toolReferenceName": "getKeilProjectInfo",
                "canBeReferencedInPrompt": true,
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "description": "No parameters required. Returns information about the currently active Keil project in the workspace."
                }
            }
        ],
        "snippets": [
            {
                "language": "a51",
                "path": "./syntaxes/a51.snippets.json"
            }
        ],
        "languages": [
            {
                "id": "a51",
                "aliases": [
                    "A51",
                    "8051 Assembly"
                ],
                "extensions": [
                    ".a51",
                    ".A51"
                ],
                "filenamePatterns": [
                    "**/*.a51",
                    "**/*.A51"
                ],
                "configuration": "./syntaxes/a51.language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "a51",
                "scopeName": "source.asm.a51",
                "path": "./syntaxes/a51.tmLanguage.json"
            }
        ],
        "views": {
            "explorer": [
                {
                    "id": "project",
                    "name": "Keil uVision Project"
                }
            ]
        },
        "taskDefinitions": [
            {
                "type": "keil-task",
                "required": [
                    "projectFile",
                    "targetName",
                    "action"
                ],
                "properties": {
                    "projectFile": {
                        "type": "string",
                        "description": "Keil .uvproj/.uvprojx file path"
                    },
                    "targetName": {
                        "type": "string",
                        "description": "Keil target name"
                    },
                    "action": {
                        "type": "string",
                        "enum": [
                            "build",
                            "rebuild",
                            "download"
                        ],
                        "description": "Keil action"
                    }
                }
            }
        ],
        "problemMatchers": [
            {
                "name": "c51",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+(#\\d+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "armcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^([^\\(]+)\\(([\\d]+)\\):\\s+(error|warning):\\s+#([\\d\\w-]+):\\s+(.+)$",
                        "file": 1,
                        "location": 2,
                        "severity": 3,
                        "code": 4,
                        "message": 5
                    }
                ]
            },
            {
                "name": "gcc",
                "fileLocation": "autoDetect",
                "pattern": [
                    {
                        "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile && webpack --mode production",
        "compile": "npx tsc -p ./",
        "watch": "npx tsc -watch -p ./",
        "webpack": "npx webpack --mode development",
        "webpack:watch": "npx webpack --mode development --watch",
        "lint": "npx eslint src --ext .ts",
        "pretest": "npm run lint && npm run compile",
        "test": "node ./scripts/run-mocha.js",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/glob": "^7.1.1",
        "@types/mocha": "^10.0.1",
        "@types/node": "^18.19.86",
        "@types/vscode": "^1.85.0",
        "@types/xml2js": "^0.4.14",
        "@typescript-eslint/eslint-plugin": "^5.54.0",
        "@typescript-eslint/parser": "^5.54.0",
        "@vscode/vsce": "^3.6.0",
        "eslint": "^8.35.0",
        "glob": "^7.1.5",
        "mocha": "^12.0.0",
        "ts-loader": "^9.4.2",
        "typescript": "^4.9.5",
        "webpack": "^5.75.0",
        "webpack-cli": "^5.0.1"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1",
        "xml2js": "^0.6.2"
    },
    "license": "MIT AND Apache-2.0",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": false,
            "description": "Keil build commands and workspace configuration require trust."
        }
    }
}
